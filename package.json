{
  "name": "school-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "School Nexus Academy - Modern school management system",
  "author": "School Nexus Team",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" next dev",
    "build": "cross-env NEXT_PUBLIC_PLATFORM=cloudflare next build --webpack && npx @cloudflare/next-on-pages --experimental-minify",
    "build:local": "cross-env NEXT_PUBLIC_PLATFORM=local next build --webpack",
    "build:stable": "cross-env NEXT_PUBLIC_PLATFORM=cloudflare NODE_OPTIONS=\"--max-old-space-size=10240\" next build --webpack && npx @cloudflare/next-on-pages --experimental-minify",
    "deploy:cloudflare": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudflare.ps1",
    "dev:d1": "concurrently \"cross-env NODE_OPTIONS=\"\"--max-old-space-size=8192\"\" next dev --port 3005\" \"npx wrangler pages dev --proxy 3005 --d1 DB=school-nexus-db --compatibility-flag nodejs_compat\"",
    "db:setup:local": "npx wrangler d1 execute school-nexus-db --local --file=drizzle/0000_initial.sql",
    "db:setup:remote": "npx wrangler d1 execute school-nexus-db --remote --file=drizzle/0000_initial.sql",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "clean": "node scripts/clean.cjs",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron dist-electron/electron/main.js\"",
    "generate-icons": "node scripts/generate-icons.cjs",
    "preelectron-build": "npm run generate-icons",
    "electron-build": "node scripts/electron-build.js",
    "build-electron": "npm run clean && npm run build:local && tsc -p tsconfig.electron.json && electron-builder",
    "build-electron:clean": "npm run clean && npm run build-electron",
    "build-desktop": "node scripts/build-desktop.js",
    "build-standalone": "node scripts/build-standalone-installer.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.schoolnexus.app",
    "productName": "SchoolNexus",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "npmRebuild": true,
    "files": [
      "dist-electron/**/*",
      ".next/**/*",
      "public/**/*",
      "drizzle/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sqlite3/**/*",
      "node_modules/bcryptjs/**/*",
      "node_modules/jsonwebtoken/**/*",
      "node_modules/@types/node/**/*",
      "node_modules/next/**/*",
      "node_modules/react/**/*",
      "node_modules/react-dom/**/*",
      ".next/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "drizzle/**/*"
    ],
    "compression": "normal",
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "School Nexus Setup ${version}.${ext}",
      "forceCodeSigning": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Nexus",
      "multiLanguageInstaller": false,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false,
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "School Nexus Portable ${version}.${ext}",
      "unicode": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png",
      "category": "public.app-category.education",
      "darkModeSupport": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Education"
    },
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "protocols": [
      {
        "name": "School Nexus Academy",
        "schemes": [
          "schoolnexus"
        ]
      }
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.17.9",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "critters": "^0.0.23",
    "date-fns": "^3.0.6",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.49.2",
    "react-to-print": "^3.2.0",
    "recharts": "^2.10.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testsprite/testsprite-mcp": "^0.0.29",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "^4.28.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "png-to-ico": "^1.0.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.5.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.8",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "html2canvas": "^1.4.1"
  }
}
